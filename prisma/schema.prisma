generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String
  password        String
  role            Role               @default(STAFF)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assignedTickets TicketAssignment[]
  comments        TicketComment[]
}

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  company      String?
  quickbooksId String?  @unique
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  domains      Domain[]
  tickets      Ticket[]
  hostingAccounts HostingAccount[]
}

model Domain {
  id          String       @id @default(cuid())
  name        String       @unique
  clientId    String?
  registrar   String?
  synergyId   String?
  expiresAt   DateTime?
  autoRenew   Boolean      @default(true)
  status      DomainStatus @default(ACTIVE)
  nameservers String[]
  source      String       @default("MANUAL")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dnsRecords  DnsRecord[]
  client      Client?      @relation(fields: [clientId], references: [id])
}

model DnsRecord {
  id        String   @id @default(cuid())
  domainId  String
  type      DnsType
  name      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String             @id @default(cuid())
  title       String
  description String
  status      TicketStatus       @default(OPEN)
  priority    Priority           @default(MEDIUM)
  clientId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  client      Client             @relation(fields: [clientId], references: [id])
  assignments TicketAssignment[]
  comments    TicketComment[]
}

model TicketAssignment {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])

  @@id([ticketId, userId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  STAFF
}

enum DomainStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TRANSFERRED
  SUSPENDED
}

enum DnsType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model HostingAccount {
  id            String   @id @default(cuid())
  username      String   @unique
  primaryDomain String
  plan          String?
  diskUsedMb    Int?
  diskLimitMb   Int?
  ip            String?
  email         String?
  suspended     Boolean  @default(false)
  source        String   @default("WHM")
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
