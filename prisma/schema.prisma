generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      Role      @default(STAFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignedTickets TicketAssignment[]
  comments        TicketComment[]
}

enum Role {
  ADMIN
  STAFF
}

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  company      String?
  quickbooksId String?  @unique
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains Domain[]
  tickets Ticket[]
}

model Domain {
  id          String       @id @default(cuid())
  name        String       @unique
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id])
  registrar   String?
  synergyId   String?
  expiresAt   DateTime?
  autoRenew   Boolean      @default(true)
  status      DomainStatus @default(ACTIVE)
  nameservers String[]
  dnsRecords  DnsRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum DomainStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TRANSFERRED
  SUSPENDED
}

model DnsRecord {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      DnsType
  name      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DnsType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
}

model Ticket {
  id          String        @id @default(cuid())
  title       String
  description String
  status      TicketStatus  @default(OPEN)
  priority    Priority      @default(MEDIUM)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  comments    TicketComment[]
  assignments TicketAssignment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model TicketAssignment {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id])

  @@id([ticketId, userId])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
